# Environment variables for Weather Forecast LSTM Project
# 
# This project uses hardcoded configuration constants defined in config.py.
# Add any sensitive values or override defaults here.

# Model configuration
LSTM_UNITS_1=128
LSTM_UNITS_2=64
DROPOUT_RATE=0.3
L2_REG_STRENGTH=0.00005
LEARNING_RATE=0.001
BATCH_SIZE=64
EPOCHS=100
PATIENCE=10

# Data paths
DATA_DIR=data
CSV_FILES=mpi_roof_2014a.csv,mpi_roof_2014b.csv,mpi_roof_2015a.csv,mpi_roof_2015b.csv,mpi_roof_2016a.csv,mpi_roof_2016b.csv

# Training settings
START_DATE=2014-01-01
END_DATE=2016-12-31
RESAMPLE_FREQ=1H
TIME_STEPS=72
FORECAST_HORIZON=1